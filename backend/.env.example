# Keep "none" to use deterministic planning. Set to gemini to enable GenAI query planning.
GENAI_PROVIDER=none
GEMINI_API_KEY=
GENAI_MODEL=gemini-2.5-flash

# SQLite for local development; change to postgresql+psycopg://... in production.
DATABASE_URL=sqlite:///./researchpilot.db
SEMANTIC_SCHOLAR_API_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Authentication — replace before production. Do not commit your production secret.
AUTH_SECRET=replace-with-a-long-random-production-secret
# True exposes the OTP only to the local development response. Set false only after SMS delivery exists.
OTP_DEVELOPMENT_MODE=true
OTP_EXPIRY_MINUTES=10

# Optional AWS Bedrock Agent provider (Boto3 uses the standard AWS credential chain).
AWS_REGION=ap-south-1
BEDROCK_AGENT_ID=
BEDROCK_AGENT_ALIAS_ID=
# Set GENAI_PROVIDER=bedrock_agent only after configuring the two values above.
